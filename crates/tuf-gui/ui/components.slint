// Ubuntu 24 (Yaru / Libadwaita + COSMIC) Component Library
// Uses 100% opaque solid tokens and padded layouts for instant software-renderer speed and zero clipping.

export global Yaru {
    in-out property <bool> dark-mode: true;

    out property <color> bg: dark-mode ? #1c1c1c : #F6F5F4;
    out property <color> header: dark-mode ? #242424 : #EBEBEB;
    out property <color> header-border: dark-mode ? #323232 : #D4D1CD;
    out property <color> surface: dark-mode ? #282828 : #FFFFFF;
    out property <color> surface-2: dark-mode ? #343434 : #F0EFEE;
    out property <color> surface-3: dark-mode ? #404040 : #E6E4E2;
    out property <color> card: dark-mode ? #282828 : #FFFFFF;
    out property <color> border: dark-mode ? #383838 : #DCDAD7;
    out property <color> border-strong: dark-mode ? #464646 : #C6C3BF;
    out property <color> card-border: dark-mode ? #383838 : #DCDAD7;
    out property <color> divider: dark-mode ? #333333 : #E6E4E2;
    out property <color> control: dark-mode ? #343434 : #F0EFEE;
    out property <color> control-hover: dark-mode ? #404040 : #E6E4E2;
    out property <color> control-pressed: dark-mode ? #2c2c2c : #DCDAD7;
    out property <color> control-border: dark-mode ? #464646 : #C6C3BF;
    out property <color> control-disabled: dark-mode ? #2b2b2b : #EAE8E6;
    out property <color> control-disabled-border: dark-mode ? #353535 : #D5D2CE;
    out property <color> accent: #E95420;
    out property <color> accent-hover: #F26534;
    out property <color> accent-pressed: #C94417;
    out property <color> blue: dark-mode ? #3584E4 : #1C71D8;
    out property <color> text: dark-mode ? #F3F3F3 : #242424;
    out property <color> text-strong: dark-mode ? #ffffff : #111111;
    out property <color> text-dim: dark-mode ? #A0A0A0 : #5E5E5E;
    out property <color> text-muted: dark-mode ? #7C7C7C : #6E6E6E;
    out property <color> badge-bg: dark-mode ? #353535 : #F0EFEE;
    out property <color> green: dark-mode ? #2EC27E : #26A269;
    out property <color> yellow: dark-mode ? #F5C211 : #E5A50A;
    out property <color> red: dark-mode ? #ED333B : #C01C28;
    out property <color> error-bg: dark-mode ? #362022 : #FDE8E8;
    out property <color> error-border: dark-mode ? #783037 : #F5B7B1;
    out property <color> error-text: dark-mode ? #FCA5A5 : #991B1B;
    out property <color> switch-bg: dark-mode ? #3c3c3c : #CECCC8;
    out property <color> switch-hover: dark-mode ? #484848 : #C0BEB9;
    out property <color> switch-border: dark-mode ? #4d4d4d : #B5B2AC;
    out property <color> slider-track: dark-mode ? #3e3e3e : #D6D3CF;
    out property <color> slider-disabled: dark-mode ? #666666 : #B2AEA8;
    out property <color> tab-tray-bg: dark-mode ? #1b1b1b : #DCDAD7;
    out property <color> tab-tray-border: dark-mode ? #303030 : #C6C3BF;
    out property <color> tab-active-bg: dark-mode ? #363636 : #FFFFFF;
    out property <color> tab-hover-bg: dark-mode ? #2d2d2d : #E6E4E2;
    out property <color> tab-active-border: dark-mode ? #464646 : #C6C3BF;
    out property <color> chart-bg: dark-mode ? #1a1a1a : #F6F5F4;
    out property <color> chart-border: dark-mode ? #303030 : #DCDAD7;
    out property <color> chart-grid: dark-mode ? #282828 : #E6E4E2;
    out property <color> focus-ring: dark-mode ? #ffffff : #242424;
    out property <color> rgb-red: dark-mode ? #F28B82 : #C01C28;
    out property <color> rgb-green: dark-mode ? #81C995 : #1E7E34;
    out property <color> rgb-blue: dark-mode ? #8AB4F8 : #1A5FB4;
}

export component PreferencesGroupTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> description;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 6px;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 700;
            color: Yaru.text;
        }
        if root.description != "" : Text {
            text: root.description;
            font-size: 12px;
            color: Yaru.text-dim;
            wrap: word-wrap;
        }
    }
}

export component PreferencesCard inherits Rectangle {
    border-radius: 12px;
    border-width: 1px;
    border-color: Yaru.card-border;
    background: Yaru.card;
    clip: true;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        @children
    }
}

export component RowDivider inherits HorizontalLayout {
    padding-left: 16px;
    padding-right: 16px;
    Rectangle {
        height: 1px;
        background: Yaru.divider;
    }
}

export component ValueBadge inherits Rectangle {
    in property <string> text;
    in property <bool> highlight: false;
    in property <color> highlight_color: Yaru.accent;

    height: 28px;
    min-width: badge_row.min-width;
    border-radius: 7px;
    background: root.highlight ? root.highlight_color : Yaru.badge-bg;
    border-width: 1px;
    border-color: root.highlight ? root.highlight_color : Yaru.control-border;

    badge_row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            color: root.highlight ? #ffffff : Yaru.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible_text;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <color> active_bg: Yaru.accent;
    in property <color> active_border: Yaru.accent;
    in property <color> active_text: #ffffff;
    in property <bool> available: true;
    callback clicked();

    min-width: label_row.min-width;
    height: root.compact ? 34px : 38px;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.accessible_text != "" ? root.accessible_text : root.text;
    accessible-enabled: root.available;
    accessible-action-default => { if root.available { root.clicked(); } }

    keys := FocusScope {
        width: 0px;
        enabled: root.available;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    background: active ? root.active_bg
        : (!root.available ? Yaru.surface-2
        : (primary ? (touch.pressed ? Yaru.accent-pressed : (touch.has-hover ? Yaru.accent-hover : Yaru.accent))
        : (touch.pressed ? Yaru.control-pressed : (touch.has-hover ? Yaru.control-hover : Yaru.control))));

    border-color: keys.has-focus ? Yaru.focus-ring
        : (active ? root.active_border
        : (!root.available ? Yaru.border
        : (primary ? root.active_border : Yaru.control-border)));
    border-width: 1px;
    border-radius: 8px;
    opacity: (root.available || root.active) ? 1.0 : 0.65;

    touch := TouchArea {
        enabled: root.available;
        clicked => { root.clicked(); }
        mouse-cursor: root.available ? pointer : default;
    }

    label_row := HorizontalLayout {
        padding-left: root.compact ? 14px : 18px;
        padding-right: root.compact ? 14px : 18px;
        padding-top: 6px;
        padding-bottom: 6px;
        alignment: center;
        Text {
            text: root.text;
            color: active || (primary && root.available) ? root.active_text
                : (!root.available ? Yaru.text-dim
                : (touch.has-hover ? Yaru.text-strong : Yaru.text));
            font-size: root.compact ? 12px : 12.5px;
            font-weight: active || (primary && root.available) ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> available: true;
    in property <string> label;
    callback toggled();

    forward-focus: keys;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-enabled: root.available;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { if root.available { root.toggled(); } }

    keys := FocusScope {
        width: 0px;
        enabled: root.available;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    width: 46px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: keys.has-focus ? Yaru.focus-ring : (checked ? Yaru.accent : Yaru.switch-border);
    background: checked ? (touch.has-hover ? Yaru.accent-hover : Yaru.accent)
        : (touch.has-hover ? Yaru.switch-hover : Yaru.switch-bg);
    opacity: root.available ? 1.0 : 0.45;

    touch := TouchArea {
        enabled: root.available;
        clicked => { root.toggled(); }
        mouse-cursor: root.available ? pointer : default;
    }

    Rectangle {
        x: root.checked ? 22px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
    }
}

export component YaruSlider inherits Rectangle {
    in-out property <float> value: 50;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in property <string> accessible-label-text: "Slider";
    callback changed(float);
    callback released(float);

    private property <float> range: max(1, root.maximum - root.minimum);
    private property <float> clamped: clamp(root.value, root.minimum, root.maximum);
    private property <float> frac: (root.clamped - root.minimum) / root.range;
    private property <length> usable: max(1px, root.width - 18px);

    height: 28px;
    min-width: 140px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1.0 : 0.45;
    forward-focus: keys;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.accessible-label-text;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;

    function update-from-x(px: length) {
        let ratio = clamp((px - 9px) / root.usable, 0, 1);
        let raw = root.minimum + ratio * root.range;
        let stepped = round(raw / root.step) * root.step;
        let next = clamp(stepped, root.minimum, root.maximum);
        if next != root.value {
            root.value = next;
            root.changed(next);
        }
    }

    keys := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                let next = clamp(root.value - root.step, root.minimum, root.maximum);
                root.value = next;
                root.changed(next);
                root.released(next);
                return accept;
            }
            if event.text == Key.RightArrow {
                let next = clamp(root.value + root.step, root.minimum, root.maximum);
                root.value = next;
                root.changed(next);
                root.released(next);
                return accept;
            }
            return reject;
        }
    }

    // Track background
    Rectangle {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: root.usable;
        height: 6px;
        border-radius: 3px;
        background: Yaru.slider-track;
    }

    // Filled progress
    Rectangle {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: root.usable * root.frac;
        height: 6px;
        border-radius: 3px;
        background: root.enabled ? Yaru.accent : Yaru.slider-disabled;
    }

    // Thumb knob
    Rectangle {
        x: 9px + root.usable * root.frac - 9px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        border-width: keys.has-focus ? 2px : 1.5px;
        border-color: keys.has-focus ? Yaru.focus-ring : (root.enabled ? Yaru.accent : Yaru.slider-disabled);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.update-from-x(self.mouse-x);
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.released(root.value);
            }
        }
        moved => {
            if self.pressed {
                root.update-from-x(self.mouse-x);
            }
        }
    }
}

export component ColorSwatch inherits Rectangle {
    in property <color> swatch_color;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> available: true;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.available;
    accessible-action-default => { if root.available { root.clicked(); } }

    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: root.swatch_color;
    border-color: selected ? Yaru.focus-ring : Yaru.control-border;
    border-width: selected ? 2.5px : 1px;
    opacity: root.available ? 1.0 : 0.45;

    touch := TouchArea {
        enabled: root.available;
        clicked => { root.clicked(); }
        mouse-cursor: root.available ? pointer : default;
    }
}

export component StatTile inherits Rectangle {
    in property <string> title;
    in property <string> primary;
    in property <string> secondary;
    in property <color> indicator: Yaru.accent;

    border-radius: 12px;
    border-width: 1px;
    border-color: Yaru.card-border;
    background: Yaru.card;
    horizontal-stretch: 1;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.indicator;
                }
            }
            Text {
                text: root.title;
                color: Yaru.text-dim;
                font-size: 11px;
                font-weight: 600;
            }
        }
        Text {
            text: root.primary;
            color: Yaru.text;
            font-size: 16px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.secondary;
            color: Yaru.text-dim;
            font-size: 11px;
            overflow: elide;
        }
    }
}

export component ActionRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    min-height: max(52px, row.preferred-height);
    preferred-height: max(52px, row.preferred-height);
    background: transparent;

    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Yaru.text;
                font-size: 13px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Yaru.text-dim;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
}

export component ControlBlock inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> detail;
    background: transparent;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: Yaru.text;
                    font-size: 13px;
                    font-weight: 500;
                    wrap: word-wrap;
                }
                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Yaru.text-dim;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
            }
            if root.detail != "" : VerticalLayout {
                alignment: center;
                ValueBadge { text: root.detail; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            @children
        }
    }
}

export component Reading inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> subtitle;
    min-height: max(50px, row.preferred-height);
    preferred-height: max(50px, row.preferred-height);
    background: transparent;

    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Yaru.text;
                font-size: 13px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Yaru.text-dim;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            ValueBadge { text: root.value; }
        }
    }
}

export component ViewTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    min-width: row.min-width;
    border-radius: 8px;
    background: active ? Yaru.tab-active-bg : (touch.has-hover ? Yaru.tab-hover-bg : transparent);
    border-width: active ? 1px : 0px;
    border-color: active ? Yaru.tab-active-border : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        spacing: 5px;

        if active : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: Yaru.accent;
            }
        }

        Text {
            text: root.text;
            color: active ? Yaru.text-strong : (touch.has-hover ? Yaru.text : Yaru.text-dim);
            font-size: 12px;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

export component HistoryChart inherits Rectangle {
    in property <string> first_path;
    in property <string> second_path;
    in property <string> title;
    in property <string> scale_top;
    in property <string> scale_bottom;
    in property <string> legend;
    in property <string> peaks;

    border-radius: 12px;
    border-width: 1px;
    border-color: Yaru.card-border;
    background: Yaru.card;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;
            Text {
                text: root.title;
                color: Yaru.text;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: root.legend;
                color: Yaru.text-dim;
                font-size: 11.5px;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                width: 52px;
                alignment: space-between;
                Text { text: root.scale_top; color: Yaru.text-muted; font-size: 10px; }
                Text { text: root.scale_bottom; color: Yaru.text-muted; font-size: 10px; }
            }
            Rectangle {
                height: 76px;
                horizontal-stretch: 1;
                background: Yaru.chart-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Yaru.chart-border;

                Rectangle {
                    y: parent.height / 2;
                    height: 1px;
                    background: Yaru.chart-grid;
                }

                Path {
                    width: parent.width;
                    height: parent.height;
                    commands: root.first_path;
                    viewbox-width: 360;
                    viewbox-height: 80;
                    fit: fill;
                    stroke: Yaru.blue;
                    stroke-width: 1.8px;
                }
                Path {
                    width: parent.width;
                    height: parent.height;
                    commands: root.second_path;
                    viewbox-width: 360;
                    viewbox-height: 80;
                    fit: fill;
                    stroke: Yaru.accent;
                    stroke-width: 1.8px;
                }
            }
        }
        Text {
            text: root.peaks;
            color: Yaru.text-dim;
            font-size: 11.5px;
        }
    }
}

component StepMiniButton inherits Rectangle {
    in property <string> symbol;
    in property <string> label;
    in property <bool> available: true;
    callback clicked();

    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.available;
    accessible-action-default => { if root.available { root.clicked(); } }

    background: !root.available ? Yaru.control-disabled
        : (touch.pressed ? Yaru.control-pressed : (touch.has-hover ? Yaru.control-hover : Yaru.control));
    border-color: keys.has-focus ? Yaru.focus-ring
        : (!root.available ? Yaru.control-disabled-border : Yaru.control-border);
    opacity: root.available ? 1.0 : 0.35;

    keys := FocusScope {
        width: 0px;
        enabled: root.available;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.available;
        clicked => { root.clicked(); }
        mouse-cursor: root.available ? pointer : default;
    }

    Text {
        text: root.symbol;
        color: touch.has-hover && root.available ? Yaru.text-strong : Yaru.text;
        font-size: 12.5px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FanPointCell inherits Rectangle {
    in property <int> point_index;
    in property <int> temp;
    in property <int> pwm;
    in property <color> accent_color: Yaru.accent;
    in property <bool> can_temp_dec: true;
    in property <bool> can_temp_inc: true;
    in property <bool> can_pwm_dec: true;
    in property <bool> can_pwm_inc: true;
    in property <bool> enabled: true;
    callback temp_step(int);
    callback pwm_step(int);

    border-radius: 8px;
    border-width: 1px;
    border-color: Yaru.divider;
    background: Yaru.bg;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 6px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 5px;
            alignment: space-between;
            Text {
                text: "P" + (root.point_index + 1);
                color: Yaru.text-dim;
                font-size: 10.5px;
                font-weight: 700;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Yaru.slider-track;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * clamp(root.pwm, 0, 100) / 100;
                        height: parent.height;
                        border-radius: 2px;
                        background: root.accent_color;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: space-between;
            StepMiniButton {
                symbol: "-";
                label: "Decrease point " + (root.point_index + 1) + " temperature";
                available: root.enabled && root.can_temp_dec;
                clicked => { root.temp_step(-2); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.temp + "°";
                color: Yaru.text;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            StepMiniButton {
                symbol: "+";
                label: "Increase point " + (root.point_index + 1) + " temperature";
                available: root.enabled && root.can_temp_inc;
                clicked => { root.temp_step(2); }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: space-between;
            StepMiniButton {
                symbol: "-";
                label: "Decrease point " + (root.point_index + 1) + " fan duty";
                available: root.enabled && root.can_pwm_dec;
                clicked => { root.pwm_step(-5); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.pwm + "%";
                color: Yaru.text-dim;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            StepMiniButton {
                symbol: "+";
                label: "Increase point " + (root.point_index + 1) + " fan duty";
                available: root.enabled && root.can_pwm_inc;
                clicked => { root.pwm_step(5); }
            }
        }
    }
}

export component FanCurveGrid inherits VerticalLayout {
    in property <string> fan_title;
    in property <string> subtitle;
    in property <color> accent_color: Yaru.accent;
    in property <[int]> temps;
    in property <[int]> pwms;
    in property <bool> enabled: true;

    private property <int> t0: 40;
    private property <int> t1: 48;
    private property <int> t2: 56;
    private property <int> t3: 64;
    private property <int> t4: 72;
    private property <int> t5: 80;
    private property <int> t6: 88;
    private property <int> t7: 96;

    private property <int> p0: 0;
    private property <int> p1: 15;
    private property <int> p2: 28;
    private property <int> p3: 42;
    private property <int> p4: 58;
    private property <int> p5: 74;
    private property <int> p6: 90;
    private property <int> p7: 100;

    in-out property <bool> dirty: false;
    private property <bool> awaiting_apply: false;
    out property <[int]> edited_temps: [root.t0, root.t1, root.t2, root.t3, root.t4, root.t5, root.t6, root.t7];
    out property <[int]> edited_pwms: [root.p0, root.p1, root.p2, root.p3, root.p4, root.p5, root.p6, root.p7];

    pure function get_t(i: int) -> int {
        if i == 0 { return root.t0; }
        if i == 1 { return root.t1; }
        if i == 2 { return root.t2; }
        if i == 3 { return root.t3; }
        if i == 4 { return root.t4; }
        if i == 5 { return root.t5; }
        if i == 6 { return root.t6; }
        return root.t7;
    }

    function set_t(i: int, v: int) {
        if i == 0 { root.t0 = v; }
        else if i == 1 { root.t1 = v; }
        else if i == 2 { root.t2 = v; }
        else if i == 3 { root.t3 = v; }
        else if i == 4 { root.t4 = v; }
        else if i == 5 { root.t5 = v; }
        else if i == 6 { root.t6 = v; }
        else { root.t7 = v; }
    }

    pure function get_p(i: int) -> int {
        if i == 0 { return root.p0; }
        if i == 1 { return root.p1; }
        if i == 2 { return root.p2; }
        if i == 3 { return root.p3; }
        if i == 4 { return root.p4; }
        if i == 5 { return root.p5; }
        if i == 6 { return root.p6; }
        return root.p7;
    }

    function set_p(i: int, v: int) {
        if i == 0 { root.p0 = v; }
        else if i == 1 { root.p1 = v; }
        else if i == 2 { root.p2 = v; }
        else if i == 3 { root.p3 = v; }
        else if i == 4 { root.p4 = v; }
        else if i == 5 { root.p5 = v; }
        else if i == 6 { root.p6 = v; }
        else { root.p7 = v; }
    }

    function step_t(i: int, delta: int) {
        let raw_lo = i == 0 ? 30 : root.get_t(i - 1);
        let raw_hi = i == 7 ? 105 : root.get_t(i + 1);
        let lo = min(raw_lo, raw_hi);
        let hi = max(raw_lo, raw_hi);
        root.set_t(i, clamp(root.get_t(i) + delta, lo, hi));
        root.awaiting_apply = false;
        root.dirty = true;
    }

    function step_p(i: int, delta: int) {
        let raw_lo = i == 0 ? 0 : root.get_p(i - 1);
        let raw_hi = i == 7 ? 100 : root.get_p(i + 1);
        let lo = min(raw_lo, raw_hi);
        let hi = max(raw_lo, raw_hi);
        root.set_p(i, clamp(root.get_p(i) + delta, lo, hi));
        root.awaiting_apply = false;
        root.dirty = true;
    }

    function sync_from_props() {
        if root.temps.length >= 8 {
            root.t0 = root.temps[0];
            root.t1 = root.temps[1];
            root.t2 = root.temps[2];
            root.t3 = root.temps[3];
            root.t4 = root.temps[4];
            root.t5 = root.temps[5];
            root.t6 = root.temps[6];
            root.t7 = root.temps[7];
        }
        if root.pwms.length >= 8 {
            root.p0 = root.pwms[0];
            root.p1 = root.pwms[1];
            root.p2 = root.pwms[2];
            root.p3 = root.pwms[3];
            root.p4 = root.pwms[4];
            root.p5 = root.pwms[5];
            root.p6 = root.pwms[6];
            root.p7 = root.pwms[7];
        }
    }

    public function mark_pending() {
        root.awaiting_apply = true;
    }

    public function reset_dirty() {
        root.awaiting_apply = false;
        root.dirty = false;
        root.sync_from_props();
    }

    init => { root.sync_from_props(); }
    changed temps => {
        if !root.dirty || root.awaiting_apply {
            root.awaiting_apply = false;
            root.dirty = false;
            root.sync_from_props();
        }
    }
    changed pwms => {
        if !root.dirty || root.awaiting_apply {
            root.awaiting_apply = false;
            root.dirty = false;
            root.sync_from_props();
        }
    }
    changed enabled => {
        if root.enabled && root.awaiting_apply {
            root.awaiting_apply = false;
        }
    }

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;
        alignment: space-between;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.accent_color;
                }
            }
            Text {
                text: root.fan_title;
                color: Yaru.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.dirty ? "Modified · °C / %" : (root.subtitle != "" ? root.subtitle : "Temp (°C) / Duty (%)");
            color: root.dirty ? Yaru.accent : Yaru.text-dim;
            font-size: 11px;
            font-weight: root.dirty ? 600 : 400;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        spacing: 6px;
        for idx in [0, 1, 2, 3] : FanPointCell {
            point_index: idx;
            temp: root.get_t(idx);
            pwm: root.get_p(idx);
            accent_color: root.accent_color;
            enabled: root.enabled;
            can_temp_dec: root.get_t(idx) > (idx == 0 ? 30 : root.get_t(idx - 1));
            can_temp_inc: root.get_t(idx) < (idx == 7 ? 105 : root.get_t(idx + 1));
            can_pwm_dec: root.get_p(idx) > (idx == 0 ? 0 : root.get_p(idx - 1));
            can_pwm_inc: root.get_p(idx) < (idx == 7 ? 100 : root.get_p(idx + 1));
            temp_step(d) => { root.step_t(idx, d); }
            pwm_step(d) => { root.step_p(idx, d); }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        for idx in [4, 5, 6, 7] : FanPointCell {
            point_index: idx;
            temp: root.get_t(idx);
            pwm: root.get_p(idx);
            accent_color: root.accent_color;
            enabled: root.enabled;
            can_temp_dec: root.get_t(idx) > (idx == 0 ? 30 : root.get_t(idx - 1));
            can_temp_inc: root.get_t(idx) < (idx == 7 ? 105 : root.get_t(idx + 1));
            can_pwm_dec: root.get_p(idx) > (idx == 0 ? 0 : root.get_p(idx - 1));
            can_pwm_inc: root.get_p(idx) < (idx == 7 ? 100 : root.get_p(idx + 1));
            temp_step(d) => { root.step_t(idx, d); }
            pwm_step(d) => { root.step_p(idx, d); }
        }
    }
}
